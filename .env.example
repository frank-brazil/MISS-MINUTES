# MISSMINUTES environment configuration
# Copy this file to `.env` and fill in real values.
# Never commit a real `.env` file.

# OpenAI provider
OPENAI_API_KEY=
# Default model used by the OpenAI provider when not overridden via config.
OPENAI_MODEL=gpt-4o-mini

# SQLite memory backend
# Path to the local memory database file. Relative paths resolve against the
# working directory. Defaults to data/missminutes_memory.db when unset.
MISSMINUTES_MEMORY_DB=

# OpenAI voice providers (reuse OPENAI_API_KEY above).
# Speech-to-text (Whisper transcription).
MISSMINUTES_STT_MODEL=whisper-1
# Optional default language hint for transcription, e.g. en, hi. Leave empty
# to let the provider auto-detect from the audio.
MISSMINUTES_STT_LANGUAGE=
# Text-to-speech synthesis.
MISSMINUTES_TTS_MODEL=tts-1
MISSMINUTES_TTS_VOICE=alloy
# One of: mp3, opus, aac, flac, wav, pcm.
MISSMINUTES_TTS_FORMAT=mp3

# Research provider (HttpSearchProvider).
# Base URL of a JSON REST search endpoint implementing the MISSMINUTES search
# contract (POST {"query", "max_results"} -> {"results": [...]}).
MISSMINUTES_SEARCH_URL=
# Optional bearer token sent to the search endpoint.
MISSMINUTES_SEARCH_API_KEY=

# Distributed multi-machine layer (CHUNK 29).
# Addresses the master and worker processes bind to.  Both default to
# loopback-only (127.0.0.1); change the bind host only when you intend the
# endpoint to be reachable from other machines, and ALWAYS set the auth token.
MISSMINUTES_MASTER_HOST=127.0.0.1
MISSMINUTES_MASTER_PORT=8100
MISSMINUTES_WORKER_HOST=127.0.0.1
MISSMINUTES_WORKER_PORT=8200
# Shared token sent on the X-Auth-Token header between master and workers.
# Leave empty only for local development on loopback.  Never commit a secret.
MISSMINUTES_AUTH_TOKEN=
# Heartbeat cadence and master detachment window (seconds).
MISSMINUTES_HEARTBEAT_INTERVAL=15
MISSMINUTES_HEARTBEAT_TIMEOUT=30
# Max attempts per distributed task and max parallel dispatches per loop.
MISSMINUTES_MAX_RETRIES=2
MISSMINUTES_MAX_CONCURRENT_DISPATCH=4
MISSMINUTES_DISPATCH_TIMEOUT=30